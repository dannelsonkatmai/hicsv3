# Supabase project connection (bolt.new fills these in automatically when you
# connect Supabase from the integrations panel).
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Edge function secrets (set via `supabase secrets set`, NOT in this file) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...           (email notification provider)
# NOTIFY_FROM_EMAIL=alerts@yourdomain.com
